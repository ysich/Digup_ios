    <string name="app_name">DigUp</string>
    <string name="tagline">Describe it. Dig it up.</string>
    <string name="onboarding_intro">Search the files on this phone by what is in them: pictures, screenshots, PDFs, documents, recordings and videos. Everything runs on the device.</string>

    <string name="onboarding_model_title">1. The model</string>
    <string name="model_ready">Model ready</string>
    <string name="model_bundled_ready">Bundled model ready</string>
    <string name="model_desc">EmbeddingGemma 2 is 865 MB and downloads once. It stays on this phone; no file leaves it.</string>
    <string name="model_bundled_desc">EmbeddingGemma 2 is included in this APK (865 MB). On first launch it is copied into app storage, so reinstalling does not need a network download.</string>
    <string name="preparing_bundled_model">Preparing the bundled model…</string>
    <string name="prepare_bundled_model">Retry bundled model setup</string>
    <string name="model_bundle_hint">Keep the app open while the model is copied from the APK. This happens once per install and can take a minute.</string>
