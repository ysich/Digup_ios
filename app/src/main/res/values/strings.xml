    <string name="downloading">Downloading…</string>
    <string name="model_percent">%1$d%%</string>
    <string name="model_download_hint">Keep the app open while it downloads. If it stops, the next attempt resumes where it left off.</string>
    <string name="model_download_size">%1$s of %2$s</string>

    <string name="onboarding_photos_title">2. Photos</string>
    <string name="photos_desc">The photo library, screenshots and videos included. Android asks for read access the first time. Only items visible to DigUp are indexed.</string>
    <string name="photos_included">Photos and videos included</string>
    <string name="photos_stop">Stop indexing Photos</string>
    <string name="photos_include">Include Photos</string>
    <string name="photos_permission_denied">DigUp can read photos only with permission. Allow it in Android Settings › Apps › DigUp › Permissions.</string>

    <string name="onboarding_folders_title">3. Folders</string>
    <string name="folders_desc">Or choose folders from storage. Downloads, SD cards and cloud folders exposed by a file provider work; DigUp only reads what you choose.</string>
    <string name="choose_folders">Choose folders to search</string>
