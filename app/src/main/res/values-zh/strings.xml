    <string name="app_name">DigUp</string>
    <string name="tagline">描述它，挖出它。</string>
    <string name="onboarding_intro">按文件里的内容搜索这台手机上的文件：照片、截图、PDF、文档、录音和视频。全部在本机运行。</string>

    <string name="onboarding_model_title">1. 模型</string>
    <string name="model_ready">模型已就绪</string>
    <string name="model_bundled_ready">内置模型已就绪</string>
    <string name="model_desc">EmbeddingGemma 2 约 865 MB，只需下载一次。它保存在本机，文件不会离开设备。</string>
    <string name="model_bundled_desc">EmbeddingGemma 2（865 MB）已包含在安装包内，首次启动会复制到应用存储，卸载重装也不需要联网下载。</string>
    <string name="preparing_bundled_model">正在准备内置模型…</string>
    <string name="prepare_bundled_model">重试内置模型安装</string>
    <string name="model_bundle_hint">复制模型时请保持应用打开。每次安装只需复制一次，通常需要约一分钟。</string>
